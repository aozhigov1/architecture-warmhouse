@startuml ER_Diagram_Warmhouse

title Логическая модель данных Warmhouse (ER-диаграмма)

hide circle
skinparam linetype ortho
skinparam shadowing false

entity "User" as user {
  * id : UUID <<PK>>
  * email : VARCHAR(255) <<UNIQUE>>
  * password_hash : VARCHAR(255)
  --
  first_name : VARCHAR(100)
  last_name : VARCHAR(100)
  phone : VARCHAR(20)
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
  is_active : BOOLEAN
}

entity "House" as house {
  * id : UUID <<PK>>
  * user_id : UUID <<FK>>
  * name : VARCHAR(100)
  --
  address : VARCHAR(500)
  latitude : DECIMAL(10,8)
  longitude : DECIMAL(11,8)
  timezone : VARCHAR(50)
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "Room" as room {
  * id : UUID <<PK>>
  * house_id : UUID <<FK>>
  * name : VARCHAR(100)
  --
  type : ENUM
  floor : INTEGER
  created_at : TIMESTAMP
}

entity "DeviceType" as device_type {
  * id : UUID <<PK>>
  * category : ENUM
  * name : VARCHAR(100)
  --
  manufacturer : VARCHAR(100)
  model : VARCHAR(100)
  protocol : ENUM
  capabilities : JSON
  created_at : TIMESTAMP
}

entity "Device" as device {
  * id : UUID <<PK>>
  * house_id : UUID <<FK>>
  * device_type_id : UUID <<FK>>
  * name : VARCHAR(100)
  --
  room_id : UUID <<FK>>
  external_id : VARCHAR(255) <<UNIQUE>>
  connection_status : ENUM
  battery_level : INTEGER
  firmware_version : VARCHAR(50)
  last_seen : TIMESTAMP
  config : JSON
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "DeviceState" as device_state {
  * id : BIGINT <<PK>>
  * device_id : UUID <<FK>>
  * state : JSON
  --
  reported_at : TIMESTAMP
  created_at : TIMESTAMP
}

entity "HeatingZone" as heating_zone {
  * id : UUID <<PK>>
  * house_id : UUID <<FK>>
  * name : VARCHAR(100)
  --
  room_id : UUID <<FK>>
  target_temperature : DECIMAL(4,1)
  current_temperature : DECIMAL(4,1)
  mode : ENUM
  schedule_enabled : BOOLEAN
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "HeatingZoneDevice" as heating_zone_device {
  * heating_zone_id : UUID <<FK,PK>>
  * device_id : UUID <<FK,PK>>
  --
  role : ENUM
  priority : INTEGER
}

entity "HeatingSchedule" as heating_schedule {
  * id : UUID <<PK>>
  * heating_zone_id : UUID <<FK>>
  * day_of_week : INTEGER
  --
  time : TIME
  mode : ENUM
  target_temperature : DECIMAL(4,1)
}

entity "LightingGroup" as lighting_group {
  * id : UUID <<PK>>
  * house_id : UUID <<FK>>
  * name : VARCHAR(100)
  --
  room_id : UUID <<FK>>
  icon : VARCHAR(50)
  created_at : TIMESTAMP
}

entity "LightingGroupDevice" as lighting_group_device {
  * lighting_group_id : UUID <<FK,PK>>
  * device_id : UUID <<FK,PK>>
  --
  order_index : INTEGER
}

entity "Camera" as camera {
  * id : UUID <<PK>>
  * device_id : UUID <<FK>>
  * house_id : UUID <<FK>>
  * name : VARCHAR(100)
  --
  room_id : UUID <<FK>>
  stream_url : VARCHAR(500)
  protocol : ENUM
  resolution : VARCHAR(20)
  is_recording : BOOLEAN
  recording_schedule : JSON
  motion_detection : BOOLEAN
  created_at : TIMESTAMP
}

entity "Recording" as recording {
  * id : BIGINT <<PK>>
  * camera_id : UUID <<FK>>
  * file_path : VARCHAR(500)
  --
  start_time : TIMESTAMP
  end_time : TIMESTAMP
  duration_seconds : INTEGER
  file_size_bytes : BIGINT
  has_motion : BOOLEAN
  created_at : TIMESTAMP
}

entity "Scenario" as scenario {
  * id : UUID <<PK>>
  * house_id : UUID <<FK>>
  * name : VARCHAR(100)
  --
  description : TEXT
  icon : VARCHAR(50)
  is_enabled : BOOLEAN
  trigger_type : ENUM
  execution_count : INTEGER
  last_executed_at : TIMESTAMP
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "ScenarioCondition" as scenario_condition {
  * id : UUID <<PK>>
  * scenario_id : UUID <<FK>>
  * type : ENUM
  --
  device_id : UUID <<FK>>
  operator : ENUM
  value : VARCHAR(255)
  order_index : INTEGER
}

entity "ScenarioAction" as scenario_action {
  * id : UUID <<PK>>
  * scenario_id : UUID <<FK>>
  * order_index : INTEGER
  --
  type : ENUM
  device_id : UUID <<FK>>
  command : VARCHAR(100)
  parameters : JSON
  delay_ms : INTEGER
  message : TEXT
}

entity "TelemetryData" as telemetry {
  * time : TIMESTAMP <<PK>>
  * device_id : UUID <<FK,PK>>
  * metric_name : VARCHAR(100) <<PK>>
  --
  metric_value : DECIMAL(20,6)
  unit : VARCHAR(20)
  tags : JSON
}

entity "NotificationRule" as notification_rule {
  * id : UUID <<PK>>
  * user_id : UUID <<FK>>
  * house_id : UUID <<FK>>
  * name : VARCHAR(100)
  --
  event_type : ENUM
  device_id : UUID <<FK>>
  condition : JSON
  channels : JSON
  is_enabled : BOOLEAN
  created_at : TIMESTAMP
}

user ||..o{ house : "owns"
house ||..o{ room : "contains"

device_type ||..o{ device : "classifies"
house ||..o{ device : "contains"
room ||..o{ device : "contains"
device ||..o{ device_state : "has history"

house ||..o{ heating_zone : "contains"
room ||..o{ heating_zone : "can be"
heating_zone ||..o{ heating_schedule : "has schedule"
heating_zone }o..o{ device : "controls (M:N)" : heating_zone_device

house ||..o{ lighting_group : "contains"
room ||..o{ lighting_group : "located in"
lighting_group }o..o{ device : "contains (M:N)" : lighting_group_device

device ||--|| camera : "is"
house ||..o{ camera : "contains"
room ||..o{ camera : "located in"
camera ||..o{ recording : "creates"

house ||..o{ scenario : "contains"
scenario ||..o{ scenario_condition : "has conditions"
scenario ||..o{ scenario_action : "performs actions"

device ||..o{ telemetry : "generates"

user ||..o{ notification_rule : "configures"
house ||..o{ notification_rule : "has rules"
device ||..o{ notification_rule : "monitors"

scenario_condition }o..|| device : "references"
scenario_action }o..|| device : "acts on"

@enduml
